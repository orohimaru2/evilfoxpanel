# internal — сертификат только для localhost, браузер покажет предупреждение.
# letsencrypt — настоящий сертификат Let's Encrypt для PANEL_DOMAIN.
TLS_MODE=letsencrypt

# Домен, который открывается в браузере. Без https:// и без порта.
PANEL_DOMAIN=panel.example.com

# Почта для писем Let's Encrypt об истечении сертификата.
ACME_EMAIL=admin@example.com
