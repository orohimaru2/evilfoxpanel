{
	admin off
	auto_https off
	log {
		output stdout
		format console
		level INFO
	}
}

https://:10000 {
	tls internal

	header {
		Strict-Transport-Security "max-age=15552000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options SAMEORIGIN
		-Server
	}

	reverse_proxy panel:80
}
